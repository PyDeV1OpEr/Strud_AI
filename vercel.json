{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "strud/backend/api/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "config.py",
          "llm_client.py",
          "question_router.py",
          "semantic_router.py",
          "assistant_identity.py",
          "injection_guard.py",
          "evidence_sufficiency.py",
          "answer_intelligence.py",
          "answer_verification.py",
          "assistant_config.json",
          "vision_config.json",
          "cli/**",
          "Science/**/*.py",
          "Science/**/*.json",
          "strud/**/*.py"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/strud/backend/api/main.py" }
  ]
}
